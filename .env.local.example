# Supabase Project Settings → API からコピー
# URL は https://xxxxxxxx.supabase.co のみ（/rest/v1 は付けない）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# anon public キー（eyJ で始まる長い文字列 / もしくは sb_publishable_... 形式）
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# アプリの公開URL（メールのリダイレクト先の生成に使用）
# ローカル: http://localhost:3000 / 本番: https://<your-app>.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# サーバー専用（秘密）: ユーザーネーム→メール解決に使用。
# Project Settings → API → service_role secret（sb_secret_... または eyJ...）
# 絶対に公開・コミットしないこと（.env.local は gitignore 済み）
SUPABASE_SERVICE_ROLE_KEY=
